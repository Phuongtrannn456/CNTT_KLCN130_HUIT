{
  "info": {
    "name": "Web3GiangVien SmokeTest - Lecturer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "24 request (token GIẢNG VIÊN). Chỉ cần dán token GV → gvId tự lấy từ JWT."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var t = pm.environment.get(\"token\");",
          "if (t && t.indexOf(\".\") > -1) {",
          "  try {",
          "    var p = t.split(\".\")[1].replace(/-/g,\"+\").replace(/_/g,\"/\");",
          "    var payload = JSON.parse(atob(p));",
          "    if (payload.id) { pm.environment.set(\"gvId\", payload.id); }",
          "  } catch (e) { console.log(\"JWT decode fail:\", e.message); }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "default"
    }
  ],
  "item": [
