{
  "name": "web3-giao-duc-pho-thong-backend",
  "version": "1.0.0",
  "description": "Backend API Node.js/Express cho Nền Tảng Web3 Giáo Dục Phổ Thông",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:k12": "node scripts/seed_k12.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:ai": "node scripts/seed_ai_training_data.js",
    "deploy:k12": "hardhat run scripts/deploy-k12-registry.js --network sepolia",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:k12": "node scripts/test_k12_api.js",
    "sync:integrity": "node scripts/sync_data_integrity.js",
    "reset:test": "node scripts/reset_test_data.js"
  },
  "dependencies": {
    "@pinata/sdk": "^2.1.0",
    "axios": "^1.13.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "path": "^0.12.7",
    "pinata-web3": "^0.5.4",
    "qrcode": "^1.5.4",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "web3": "^4.0.0",
    "winston": "^3.19.0",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^4.9.5",
    "hardhat": "^2.28.6",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
